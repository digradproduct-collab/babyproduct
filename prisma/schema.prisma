// Câlin Kids — schéma de base de données
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  SOMMEIL
  SECURITE
  JEU
  EVEIL
  EXTERIEUR
  DOUDOU
  REPAS
  TRANSPORT
  AUTRE
}

enum ProductStatus {
  SPOTTED // À repérer
  TESTING // En test
  VALIDATED // Validé (commandé)
  REJECTED // Rejeté
}

enum SourcePlatform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
  PINTEREST
  YOUTUBE
  AUTRE
}

/// Régie d'affiliation fournissant un flux produits (prix, stock, lien tracké).
enum AffiliateNetwork {
  AWIN
  EFFILIATION
  RAKUTEN
  TRADEDOUBLER
  AUTRE
}

enum FeedFormat {
  CSV
  XML
  JSON
}

/// Flux produits d'une régie. L'URL contient généralement la clé d'API ou le
/// jeton fourni par la régie : elle n'est jamais exposée côté public.
model ProductFeed {
  id      String           @id @default(cuid())
  name    String
  network AffiliateNetwork
  format  FeedFormat
  url     String

  enabled Boolean @default(true)

  /// Surcharge du mapping de colonnes par défaut du réseau, quand un
  /// annonceur nomme ses colonnes différemment.
  /// { "externalId": "...", "name": "...", "price": "...", ... }
  mapping Json?

  /// Chemin vers le tableau d'articles pour les formats XML/JSON
  /// (ex. "products.product"). Vide = détection automatique.
  itemsPath String?

  lastSyncAt      DateTime?
  lastSyncOk      Boolean?
  lastSyncMessage String?
  lastItemCount   Int?
  lastMatchedCount Int?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RawSourceStatus {
  PENDING
  PROCESSED
  DISCARDED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

/// Contenu brut collecté à la main (lien + légende + métriques observées)
/// avant analyse IA. Jamais publié tel quel : sert de matière première
/// au scoring de viralité.
model RawSource {
  id                String           @id @default(cuid())
  url               String
  platform          SourcePlatform   @default(AUTRE)
  caption           String?
  observedViews     Int?
  observedLikes     Int?
  observedComments  Int?
  observedShares    Int?
  notes             String?
  status            RawSourceStatus  @default(PENDING)
  createdAt         DateTime         @default(now())
  processedAt       DateTime?
  resultingProduct  Product?
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    Category @default(AUTRE)
  description String?
  imageUrl    String?
  imageUrls   String[] @default([])
  highlights  String[] @default([])
  /// [{ "question": string, "answer": string }]
  faq         Json?
  /// [{ "author": string, "rating": number, "quote": string }]
  testimonials Json?
  /// Fin d'une promotion réelle définie par l'admin — affiche un bandeau
  /// compte à rebours honnête sur la fiche publique tant que non dépassée.
  promoEndsAt DateTime?

  sourceUrl      String?
  sourcePlatform SourcePlatform?
  rawSourceId    String?          @unique
  rawSource      RawSource?       @relation(fields: [rawSourceId], references: [id])

  supplierName        String?
  supplierUrl          String?
  estimatedPriceCents  Int?
  estimatedCostCents   Int?
  estimatedMarginPct   Float?

  /// Date du dernier relevé de prix (flux régie ou saisie manuelle). Le prix
  /// n'est affiché publiquement que s'il est suffisamment récent.
  priceUpdatedAt DateTime?
  currency       String    @default("EUR")
  inStock        Boolean?

  /// Rattachement à un flux de régie : `externalId` est l'identifiant du
  /// produit chez l'annonceur (SKU, merchant_product_id, EAN...).
  feedId     String?
  feed       ProductFeed? @relation(fields: [feedId], references: [id], onDelete: SetNull)
  externalId String?

  affiliateUrl String?

  status              ProductStatus @default(SPOTTED)
  viralScore          Int?
  viralScoreRationale String?

  rating     Float?
  tags       String[] @default([])
  isFeatured Boolean  @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  validatedAt DateTime?

  metrics   ProductMetricSnapshot[]
  clicks    Click[]
  pageViews PageView[]

  @@index([status])
  @@index([category])
  @@index([feedId, externalId])
}

/// Historique des métriques d'engagement dans le temps, pour distinguer
/// un buzz durable d'un pic isolé.
model ProductMetricSnapshot {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  engagementRate Float?
  capturedAt     DateTime @default(now())

  @@index([productId, capturedAt])
}

/// Un clic vers l'offre d'affiliation. `context` = où sur le site (fiche
/// produit, catégorie...) ; les champs `utm*` = d'où vient le visiteur à
/// l'origine (réseau social organique, campagne pub...), reconstitués depuis
/// le cookie d'attribution posé au premier atterrissage sur le site.
model Click {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  context     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  userAgent   String?
  createdAt   DateTime @default(now())

  /// false quand le produit n'avait pas encore de lien marchand au moment du
  /// clic : l'intention d'achat est réelle et comptée, mais le visiteur n'a
  /// été redirigé nulle part. Permet de ne pas mélanger ces clics avec les
  /// vrais clics sortants dans les statistiques de conversion.
  hadDestination Boolean @default(true)

  @@index([productId, createdAt])
  @@index([utmSource, createdAt])
}

/// Une vue de page publique. `productId` est renseigné quand la page est une
/// fiche produit, pour pouvoir croiser vues → clics → conversion par produit
/// et par source d'acquisition (utm*).
model PageView {
  id          String   @id @default(cuid())
  path        String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  createdAt   DateTime @default(now())

  @@index([path, createdAt])
  @@index([productId, createdAt])
  @@index([utmSource, createdAt])
}

model NewsletterSubscriber {
  id                String   @id @default(cuid())
  email             String   @unique
  unsubscribeToken  String   @unique @default(cuid())
  createdAt         DateTime @default(now())
}
